<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. This overlays (and fully replaces) src/main's strict pinned config so
    trackVerified can be tested against a locally hosted dev server: it trusts user-installed
    CAs and permits cleartext, and drops certificate pinning. Release builds keep the pinned
    config in src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
