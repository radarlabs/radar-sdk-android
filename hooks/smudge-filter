#!/bin/sh
# Radar example smudge filter - restores saved DEFAULT_PUBLISHABLE_KEY and DEFAULT_STAGING_PUBLISHABLE_KEY to working tree
KEYS_FILE="$(git rev-parse --show-toplevel)/.radar-env"

if [ ! -f "$KEYS_FILE" ]; then
    cat
    exit 0
fi

# Read a saved value and escape it for use in a sed replacement
load() {
    sed -n "s/^$1=//p" "$KEYS_FILE" | head -n 1 | sed 's/[\\&|]/\\&/g'
}

KEY=$(load publishable_key)
STAGING_KEY=$(load staging_publishable_key)

# Build sed command to apply saved values
SED_CMD=""
if [ -n "$KEY" ]; then
    SED_CMD="${SED_CMD}s|(const val DEFAULT_PUBLISHABLE_KEY = \")[^\"]*\"|\1${KEY}\"|;"
fi
if [ -n "$STAGING_KEY" ]; then
    SED_CMD="${SED_CMD}s|(const val DEFAULT_STAGING_PUBLISHABLE_KEY = \")[^\"]*\"|\1${STAGING_KEY}\"|;"
fi

if [ -z "$SED_CMD" ]; then
    cat
else
    sed -E "$SED_CMD"
fi
